<?xml version="1.0" encoding="utf-8"?>
<!-- Tarcza zaćmienia (SPEC 11.7): świecąca korona w kolorze Korony #E9B949 i ciemna tarcza.
     Całość mieści się w bezpiecznej strefie ikony adaptacyjnej (koło o promieniu 33). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- poświata korony -->
    <path android:pathData="M54,22a32,32 0,1 1,0 64a32,32 0,1 1,0 -64z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0.55" android:color="#FFF2CE6B" />
                <item android:offset="0.68" android:color="#CCE9B949" />
                <item android:offset="1.0" android:color="#00E9B949" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- tarcza (księżyc) -->
    <path android:pathData="M54,35a19,19 0,1 1,0 38a19,19 0,1 1,0 -38z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="48"
                android:centerY="47"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#FF1B2150" />
                <item android:offset="1" android:color="#FF0D1230" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
