<?xml version="1.0" encoding="utf-8"?>
<!-- Dane logowania i klucz Tinka nie trafiają do kopii ani przenosin na nowy telefon (SPEC 10.3).
     Klucz główny i tak zostaje w Android Keystore tego telefonu, więc kopia byłaby bezużyteczna. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
        <exclude domain="sharedpref" path="eclipse_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
        <exclude domain="sharedpref" path="eclipse_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
